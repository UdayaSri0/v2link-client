[Unit]
Description=v2link-client optional per-application traffic monitor
Documentation=https://github.com/UdayaSri0/v2link-client
After=network.target

[Service]
Type=simple
User=v2link-netmon
Group=v2link-netmon
ExecStart=/usr/lib/v2link-client/v2link-netmon
RuntimeDirectory=v2link-client
RuntimeDirectoryMode=0750
StateDirectory=v2link-client
StateDirectoryMode=0750
UMask=0007
Environment=V2LINK_NETMON_SOCKET=/run/v2link-client/netmon.sock
Environment=V2LINK_NETMON_DB=/var/lib/v2link-client/netmon.sqlite3
Restart=on-failure
RestartSec=3

# The v0.2.4 helper has no production eBPF backend. Prompt 3B must reassess
# privileges before a real backend is introduced.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/v2link-client /var/lib/v2link-client
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
